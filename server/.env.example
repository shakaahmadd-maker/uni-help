# Backend Environment Variables (server/.env.example)

NODE_ENV=production
# Internal container port (set to 4000 to avoid conflicting with host port 3001)
PORT=4000

# PostgreSQL Connection String (uses Docker service name "postgres" on the internal bridge network)
DATABASE_URL=postgresql://uni_help_user:your_secure_db_password_here@postgres:5432/uni_help

# JSON Web Token Secret (generate a 64+ char random hex string in production)
JWT_SECRET=replace_this_with_a_cryptographically_secure_random_secret_string

# Allowed Frontend Origins for CORS (comma-separated or * for all)
CORS_ORIGIN=https://unihelp.com,http://localhost:8080,http://localhost:3000

# Initial default password for provisioned Super Admin accounts during seed
ADMIN_INITIAL_PASSWORD=admin123
