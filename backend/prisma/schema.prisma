generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ADMISSIONS_COACH
  VISA_SPECIALIST
  OPERATIONS_LEAD
  COUNSELOR
}

enum SubmissionStatus {
  NEW
  CONTACTED
  RESOLVED
  DELETED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String?
  role         Role         @default(ADMIN)
  isActive     Boolean      @default(true)
  isVerified   Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastLoginAt  DateTime?

  assignedSubmissions Submission[]

  @@index([email])
  @@index([role])
}

model Submission {
  id           String           @id @default(uuid())
  legacyId     String?          @unique
  name         String
  email        String
  phone        String?
  city         String?
  service      String
  message      String           @db.Text
  status       SubmissionStatus @default(NEW)
  notes        String?          @db.Text
  assignedToId String?
  assignedTo   User?            @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([service])
}

model SuccessStory {
  id            String   @id @default(uuid())
  legacyId      String?  @unique @map("legacy_id")
  name          String
  maskedName    String?  @map("masked_name")
  city          String
  stream        String
  review        String   @db.Text
  rating        Int      @default(5)
  clientPic     String?  @map("client_pic") @db.Text
  visaStamp     String?  @map("visa_stamp") @db.Text
  stampId       String?  @map("stamp_id")
  visaGrantDate String?  @map("visa_grant_date")
  isPublished   Boolean  @default(true) @map("is_published")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("success_stories")
  @@index([city])
  @@index([isPublished])
  @@index([createdAt])
}
