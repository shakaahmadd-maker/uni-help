# Backend Environment Variables (backend/.env.example)

NODE_ENV=production
# Internal container port
PORT=3000

# PostgreSQL Connection String (uses Docker service name "postgres" on the internal network)
DATABASE_URL=postgresql://uni_help_user:CHANGE_ME_PASSWORD@postgres:5432/uni_help

# JSON Web Token Secret (generate a 64+ char random hex string in production)
JWT_SECRET=replace_this_with_a_cryptographically_secure_random_secret_string

# Allowed Frontend Origins for CORS (comma-separated or * for all)
CORS_ORIGIN=https://unihelpconsultants.com,http://localhost:8080,http://localhost:3000

# Initial default password for provisioned Super Admin accounts during seed
ADMIN_INITIAL_PASSWORD=admin123
